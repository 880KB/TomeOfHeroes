<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.swim.toh.ui.controller.ClassesViewController">
   <center>
      <TableView fx:id="classesTableView" editable="true" fixedCellSize="28.0" maxHeight="140.0">
        <columns>
          <TableColumn fx:id="classTableColumn" editable="false" prefWidth="75.0" text="Klasse" />
          <TableColumn fx:id="levelTableColumn" prefWidth="75.0" sortType="DESCENDING" text="Stufe" />
            <TableColumn fx:id="isFirstClassTableColumn" prefWidth="75.0" text="1. Klasse" />
            <TableColumn fx:id="actionTableColumn" prefWidth="40.0" resizable="false" />
        </columns>
      </TableView>
   </center>
   <bottom>
      <Button fx:id="addClassButton" mnemonicParsing="false" text="Klasse hinzufügen" BorderPane.alignment="CENTER_LEFT">
         <BorderPane.margin>
            <Insets top="5.0" />
         </BorderPane.margin>
      </Button>
   </bottom>
</BorderPane>
