<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.swim.toh.ui.controller.WeaponsViewController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="5.0" BorderPane.alignment="CENTER_LEFT">
         <BorderPane.margin>
            <Insets bottom="5.0" />
         </BorderPane.margin>
         <children>
            <Label style="-fx-font-weight: bold; -fx-font-size: 13px;" text="Angriff" />
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="weaponsTableView" editable="true" fixedCellSize="28.0" BorderPane.alignment="TOP_CENTER">
        <columns>
            <TableColumn fx:id="slotColumn" editable="false" maxWidth="85.0" minWidth="85.0" prefWidth="85.0" resizable="false" text="Slot" />
            <TableColumn fx:id="weaponColumn" editable="false" minWidth="120.0" prefWidth="140.0" text="Waffe" />
            <TableColumn fx:id="damageColumn" editable="false" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" resizable="false" text="Schaden" />
            <TableColumn fx:id="criticalColumn" editable="false" maxWidth="55.0" minWidth="55.0" prefWidth="55.0" resizable="false" text="Krit." />
            <TableColumn fx:id="rangeColumn" editable="false" maxWidth="75.0" minWidth="75.0" prefWidth="75.0" resizable="false" text="Reichweite" />
            <TableColumn fx:id="damageTypeColumn" editable="false" maxWidth="90.0" minWidth="90.0" prefWidth="90.0" resizable="false" text="Art" />
            <TableColumn fx:id="attackBonusColumn" editable="false" maxWidth="90.0" minWidth="90.0" prefWidth="90.0" resizable="false" text="Angriffsbonus" />
            <TableColumn fx:id="noteColumn" minWidth="120.0" prefWidth="140.0" text="Anmerkung" />
            <TableColumn fx:id="actionColumn" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" resizable="false" />
        </columns>
      </TableView>
   </center>
</BorderPane>
