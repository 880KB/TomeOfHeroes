<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<GridPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.swim.toh.ui.controller.HitPointsViewController">
    <columnConstraints>
        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="10.0" prefWidth="30.0" />
        <ColumnConstraints halignment="CENTER" hgrow="NEVER" maxWidth="-Infinity" minWidth="10.0" prefWidth="50.0" />
        <ColumnConstraints halignment="CENTER" hgrow="NEVER" minWidth="10.0" />
        <ColumnConstraints halignment="CENTER" hgrow="NEVER" maxWidth="-Infinity" minWidth="10.0" prefWidth="50.0" />
        <ColumnConstraints halignment="CENTER" hgrow="NEVER" minWidth="10.0" />
        <ColumnConstraints halignment="CENTER" hgrow="NEVER" maxWidth="-Infinity" minWidth="10.0" prefWidth="50.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints maxHeight="-Infinity" minHeight="10.0" vgrow="NEVER" />
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="NEVER" />
    </rowConstraints>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
    </padding>

    <Label text="TP" GridPane.rowIndex="1" />
    <TextField fx:id="currentHitPointsTextField" alignment="CENTER" maxWidth="-Infinity" prefWidth="40.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    <Label text="/" GridPane.columnIndex="2" GridPane.rowIndex="1" />
    <TextField fx:id="baseMaxHitPointsTextField" alignment="CENTER" maxWidth="-Infinity" prefWidth="40.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />
    <Label text="=" GridPane.columnIndex="4" GridPane.rowIndex="1" />
    <TextField fx:id="totalMaxHitPointsTextField" alignment="CENTER" editable="false" maxWidth="-Infinity" prefWidth="40.0" styleClass="field-computed" GridPane.columnIndex="5" GridPane.rowIndex="1" />

    <Label text="Basis" GridPane.columnIndex="3">
        <font><Font size="11.0" /></font>
    </Label>
    <Label text="Gesamt" GridPane.columnIndex="5">
        <font><Font size="11.0" /></font>
    </Label>
</GridPane>
