<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.swim.toh.ui.controller.dialog.SelectionDialogController">
<center>
    <TableView fx:id="itemsTableView" editable="true" fixedCellSize="26">
        <columns>
            <TableColumn fx:id="isSelectedColumn" maxWidth="40.0" minWidth="40.0" prefWidth="40.0" resizable="false" sortable="false" />
            <TableColumn fx:id="nameColumn" prefWidth="200" sortable="false" text="Name" />
            <TableColumn fx:id="infoColumn" maxWidth="30.0" minWidth="30.0" prefWidth="30.0" resizable="false" sortable="false" />
            <TableColumn fx:id="reasonColumn" prefWidth="400" sortable="false" text="Voraussetzungen" />
        </columns>
    </TableView>
</center>
<bottom>
    <HBox alignment="CENTER_RIGHT" spacing="5.0" BorderPane.alignment="CENTER_LEFT">
        <BorderPane.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
        </BorderPane.margin>
        <Button mnemonicParsing="false" onAction="#onCancel" text="Abbrechen" />
        <Button mnemonicParsing="false" onAction="#onOk" text="OK" />
    </HBox>
</bottom>
</BorderPane>
